{#- Base layout: <head>, nav, footer and scripts for every page.
    Front matter it reads:
      title, description          — <title> and meta description
      ogTitle, ogDescription      — social previews (default to title / description)
      ogType: website | article   — article pages also get Article JSON-LD
      nav: work | writing         — highlights that nav link on subpages
      skipTo                      — skip-link target (default #content)
      css: [ "/assets/css/…" ]    — extra stylesheets
      scripts: [ "/assets/js/…" ] — extra scripts, loaded after the shared ones
      pet, hud                    — load pet.js + catch.js (home) / ddia-hud.js
      date                        — publish date (articles: JSON-LD, feed)
      noindex                     — keep the page out of search results (404)
      takeaways                   — loads oak.js (see layouts/article.njk) -#}
{%- set isHome = page.url == "/" -%}
{%- set navBase = "" if isHome else "/" -%}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="theme-color" content="#202825">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ site.image }}">
  <meta name="twitter:card" content="summary_large_image">

  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="Sagun B. Pradhan — Writing" href="/feed.xml">
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | v }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/img/favicon.png' | v }}" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | v }}">

  <link rel="preload" href="/assets/fonts/archivo-latin.woff2?v=2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/fonts.css' | v }}">

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | v }}">
  <link rel="stylesheet" href="{{ '/assets/css/pokedex.css' | v }}">
  {%- for sheet in css %}
  <link rel="stylesheet" href="{{ sheet | v }}">
  {%- endfor %}
  <link rel="stylesheet" href="{{ '/assets/css/retro.css' | v }}">

  {%- if isHome %}
  {% include "partials/person-jsonld.njk" %}
  <script type="application/ld+json">
  { "@context": "https://schema.org", "@type": "WebSite", "name": "{{ site.author }}", "url": "{{ site.url }}/" }
  </script>
  {%- elif ogType == "article" %}
  {% include "partials/article-jsonld.njk" %}
  {%- endif %}
</head>

<body>

  <a class="skip-link" href="{{ skipTo or '#content' }}">Skip to content</a>

  <!-- ============================= Nav ============================= -->
  <nav class="nav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="{{ navBase }}#top">
        <span class="pokeball" aria-hidden="true"></span>
        <span>
          <span class="nav__name">SAGUN B. PRADHAN</span>
          <span class="nav__level">LV 30 · DATA ENGINEER</span>
        </span>
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-tab" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
      <div class="nav__tab" id="nav-tab">
        {#- [key, label, href]; no href = a section on the home page #}
        {%- for item in [["work", "WORK"], ["experience", "EXPERIENCE"], ["about", "ABOUT"], ["writing", "WRITING"], ["pomodoro", "POMODORO", "/pomodoro/"], ["contact", "CONTACT"]] %}
        <a class="nav__link{% if nav == item[0] %} is-active{% endif %}" href="{{ item[2] or (navBase + '#' + item[0]) }}"><span class="pokeball pokeball--sm" aria-hidden="true"></span>{{ item[1] }}</a>
        {%- endfor %}
      </div>
    </div>
  </nav>

{{ content | safe }}

  <!-- =========================== Footer ============================ -->
  {% include "partials/footer.njk" %}

  {#- DDIA chapters for the Pokédex menu (Menu › Writing › Reading DDIA) #}
  <script type="application/json" id="ddia-chapters">
  {{ collections.chapters | chapterMenu | dump | safe }}
  </script>

  <script src="{{ '/assets/js/app.js' | v }}"></script>
  {%- if pet %}
  <script src="{{ '/assets/js/pet.js' | v }}"></script>
  <script src="{{ '/assets/js/catch.js' | v }}"></script>
  {%- endif %}
  {%- if hud %}
  <script src="{{ '/assets/js/ddia-hud.js' | v }}"></script>
  {%- endif %}
  <script src="{{ '/assets/js/chiptune.js' | v }}"></script>
  <script src="{{ '/assets/js/pokedex.js' | v }}"></script>
  {%- for s in scripts %}
  <script src="{{ s | v }}"></script>
  {%- endfor %}
  {%- if takeaways %}
  <script src="{{ '/assets/js/oak.js' | v }}"></script>
  {%- endif %}
</body>

</html>
