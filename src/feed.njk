---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Sagun B. Pradhan — Writing</title>
  <subtitle>Case studies and chapter-by-chapter notes on Designing Data-Intensive Applications.</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{{ (collections.posts | first).inputPath | gitModified }}</updated>
  <author><name>{{ site.author }}</name></author>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ (post.data.ogTitle or post.data.title) }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ post.inputPath | gitModified }}</updated>
    <summary>{{ post.data.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
